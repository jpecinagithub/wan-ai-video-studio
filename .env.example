# ── WAN AI Video Studio · Variables de entorno ─────────────────────────
# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas variables en el panel del proyecto
# (Settings → Environment Variables → Production). NUNCA las subas al repositorio.
#
# ⚠️ Ningún secreto lleva el prefijo VITE_: todo lo que empiece por VITE_
# se expone en el código del cliente. La API key vive SOLO en el servidor.

# Clave de API de Alibaba Cloud Model Studio (SOLO servidor, obligatoria).
# Créala en la consola de Model Studio (API Keys) y cópiala aquí sin espacios.
ALIBABA_API_KEY=

# Región de Model Studio (opcional, defecto: ap-southeast-1).
# El modelo, la clave y la región deben pertenecer a la misma región/scope:
# una clave creada para otra región no funcionará.
ALIBABA_REGION=ap-southeast-1

# Workspace ID de Model Studio (opcional). Si se indica, el servidor puede
# construir la URL base regional a partir de la región y el workspace.
ALIBABA_WORKSPACE_ID=

# URL base completa de la API de Model Studio (opcional).
# Tiene prioridad máxima: si está definida, sustituye a la construcción
# por región/workspace.
ALIBABA_API_BASE_URL=

# ── Variables públicas (no sensibles) ────────────────────────────────────
# Nombre público de la aplicación (opcional).
VITE_APP_NAME="WAN AI Video Studio"
